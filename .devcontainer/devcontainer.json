{
  "name": "ns-reisadvies tests + mypy",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.13-bookworm",

  "postCreateCommand": "pip install --upgrade pip && pip install -r tests/requirements_test.txt && pip install pytest-cov mypy",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.mypy-type-checker"
      ],
      "settings": {
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": [
          "tests"
        ]
      }
    }
  },

  "remoteEnv": {
    "PYTHONPATH": "${containerWorkspaceFolder}"
  }
}
